    "Purchases are processed by RevenueCat and Apple's App Store. We receive your subscription status (active, trial, expired) but never your payment details - Apple handles those directly." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purchases are processed by RevenueCat and Apple's App Store. We receive your subscription status (active, trial, expired) but never your payment details - Apple handles those directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las compras son procesadas por RevenueCat y la App Store de Apple. Recibimos el estado de tu suscripción (activa, prueba, caducada) pero nunca tus datos de pago - Apple los gestiona directamente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakupy są przetwarzane przez RevenueCat i App Store firmy Apple. Otrzymujemy status Twojej subskrypcji (aktywna, próbna, wygasła), ale nigdy dane płatności - Apple obsługuje je bezpośrednio."
          }
        }
      }
    },
