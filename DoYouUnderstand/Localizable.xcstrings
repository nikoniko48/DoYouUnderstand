    "Still confused? Let's cut to the chase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Immer noch verwirrt? Kommen wir zur Sache."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Still confused? Let's cut to the chase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sigues confundido? Vayamos al grano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours perdu ? Allons droit au but."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ迷ってる?単刀直入に行こう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직도 헷갈려요? 바로 본론으로 가봅시다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadal zdezorientowany? Przejdźmy do sedna."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda confuso? Vamos direto ao ponto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还是搞不清楚？我们直接说重点。"
          }
        }
      }
    },
    "STOP GUESSING\nWHAT THEY MEAN." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HÖR AUF ZU RATEN\nWAS SIE MEINEN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STOP GUESSING\nWHAT THEY MEAN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEJA DE ADIVINAR\nQUÉ QUISIERON DECIR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ARRÊTE DE DEVINER\nCE QU'ILS VEULENT DIRE."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手の真意を\n推測するのはもうやめよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상대의 의도를\n그만 추측하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PRZESTAŃ ZGADYWAĆ,\nCO MIELI NA MYŚLI."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PARE DE ADIVINHAR\nO QUE ELES QUEREM DIZER."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别再猜\n他们到底想说什么。"
          }
        }
      }
    },
    "STOP OVERTHINKING\nYOUR TEXTS." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HÖR AUF, DEINE NACHRICHTEN\nZU ZERDENKEN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "STOP OVERTHINKING\nYOUR TEXTS."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DEJA DE PENSAR DE MÁS\nTUS MENSAJES."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ARRÊTE DE TROP RÉFLÉCHIR\nÀ TES MESSAGES."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージのことで\n考えすぎるのはやめよう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "문자 때문에\n너무 고민하지 마세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PRZESTAŃ ROZMYŚLAĆ\nNAD WIADOMOŚCIAMI."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PARE DE PENSAR DEMAIS\nNAS SUAS MENSAGENS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别再为发消息\n想太多了。"
          }
        }
      }
    },
