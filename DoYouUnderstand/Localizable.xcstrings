    "We don't sell your data, run third-party ad networks, or share your messages with anyone beyond the Gemini call needed to generate your result." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir verkaufen deine Daten nicht, betreiben keine Drittanbieter-Werbenetzwerke und teilen deine Nachrichten mit niemandem außer dem für dein Ergebnis benötigten Gemini-Aufruf."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We don't sell your data, run third-party ad networks, or share your messages with anyone beyond the Gemini call needed to generate your result."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No vendemos tus datos, no operamos redes publicitarias de terceros, ni compartimos tus mensajes con nadie más allá de la llamada a Gemini necesaria para generar tu resultado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne vendons pas vos données, n'exploitons pas de réseaux publicitaires tiers, et ne partageons vos messages avec personne au-delà de l'appel à Gemini nécessaire pour générer votre résultat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私たちはあなたのデータを販売したり、サードパーティの広告ネットワークを運営したり、結果生成に必要なGemini呼び出し以外であなたのメッセージを誰かと共有したりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저희는 데이터를 판매하거나 제3자 광고 네트워크를 운영하지 않으며, 결과 생성을 위해 필요한 Gemini 호출 외에는 메시지를 그 누구와도 공유하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie sprzedajemy Twoich danych, nie prowadzimy sieci reklamowych stron trzecich ani nie udostępniamy Twoich wiadomości nikomu poza wywołaniem Gemini niezbędnym do wygenerowania wyniku."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não vendemos seus dados, não operamos redes de anúncios de terceiros, nem compartilhamos suas mensagens com ninguém além da chamada ao Gemini necessária para gerar seu resultado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们不会出售你的数据，不运营第三方广告网络，也不会将你的消息分享给除生成结果所需的 Gemini 调用之外的任何人。"
          }
        }
      }
    },
    "We need to talk." : {
