        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te preocupes por elegir mal. Siempre puedes cambiarlo después en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne vous inquiétez pas de faire le mauvais choix. Vous pourrez toujours le changer plus tard dans les Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選び間違えても大丈夫。設定でいつでも変更できます。"
