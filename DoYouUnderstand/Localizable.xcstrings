    "English, Polish, and Spanish are fully translated. Other languages will keep showing English until they're added." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Englisch, Polnisch und Spanisch sind vollständig übersetzt. Andere Sprachen zeigen weiterhin Englisch an, bis sie hinzugefügt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "English, Polish, and Spanish are fully translated. Other languages will keep showing English until they're added."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inglés, el polaco y el español están totalmente traducidos. Los demás idiomas seguirán mostrándose en inglés hasta que se añadan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'anglais, le polonais et l'espagnol sont entièrement traduits. Les autres langues afficheront l'anglais jusqu'à ce qu'elles soient ajoutées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英語、ポーランド語、スペイン語は完全に翻訳されています。他の言語は追加されるまで英語のまま表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영어, 폴란드어, 스페인어는 완전히 번역되어 있습니다. 다른 언어는 추가되기 전까지 영어로 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angielski, polski i hiszpański są w pełni przetłumaczone. Pozostałe języki będą wyświetlane po angielsku, dopóki nie zostaną dodane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inglês, polonês e espanhol estão totalmente traduzidos. Outros idiomas continuarão mostrando inglês até serem adicionados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "英语、波兰语和西班牙语已完整翻译。其他语言在添加之前将继续显示英文。"
          }
        }
      }
    },
