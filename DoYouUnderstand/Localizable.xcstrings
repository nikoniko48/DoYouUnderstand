    "Applies to newly generated replies. \"Auto-detect\" matches the language of the message you paste in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt für neu generierte Antworten. „Automatisch erkennen“ verwendet die Sprache der eingefügten Nachricht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies to newly generated replies. \"Auto-detect\" matches the language of the message you paste in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica a las respuestas recién generadas. \"Detección automática\" coincide con el idioma del mensaje que pegas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'applique aux nouvelles réponses générées. « Détection automatique » utilise la langue du message que vous collez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しく生成される返信に適用されます。「自動検出」は貼り付けたメッセージの言語に合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로 생성되는 답장에 적용됩니다. '자동 감지'는 붙여넣은 메시지의 언어에 맞춰집니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dotyczy nowo wygenerowanych odpowiedzi. \"Automatyczne wykrywanie\" dopasowuje język do wklejonej wiadomości."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica-se às respostas recém-geradas. \"Detecção automática\" usa o idioma da mensagem que você colar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于新生成的回复。「自动检测」会匹配你粘贴消息所使用的语言。"
          }
        }
      }
    },
