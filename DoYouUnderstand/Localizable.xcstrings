        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie martw się złym wyborem. Zawsze możesz to później zmienić w Ustawieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
