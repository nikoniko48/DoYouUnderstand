          }
        }
      }
    },
    "The text or photo you submit for analysis, and the basics you gave us during setup (name, age range, gender). That's it - no contacts, no location, no browsing history, no ad-tracking identifiers." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The text or photo you submit for analysis, and the basics you gave us during setup (name, age range, gender). That's it - no contacts, no location, no browsing history, no ad-tracking identifiers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El texto o la foto que envías para análisis, y los datos básicos que nos diste durante la configuración (nombre, rango de edad, género). Eso es todo: sin contactos, sin ubicación, sin historial de navegación, sin identificadores publicitarios."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekst lub zdjęcie przesłane do analizy oraz podstawowe dane podane podczas konfiguracji (imię, przedział wiekowy, płeć). To wszystko - żadnych kontaktów, lokalizacji, historii przeglądania ani identyfikatorów reklamowych."
          }
        }
      }
    },
    "Theme and tone colors" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theme and tone colors"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tema y colores de tono"
          }
        },
        "pl" : {
          "stringUnit" : {
