    "Everything runs on a local-first architecture. No accounts, no sign-up, no server-side profile of you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles läuft auf einer lokal-first-Architektur. Kein Konto, keine Anmeldung, kein serverseitiges Profil von dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything runs on a local-first architecture. No accounts, no sign-up, no server-side profile of you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo funciona con una arquitectura local. Sin cuentas, sin registro, sin perfil tuyo en el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout fonctionne sur une architecture axée sur le local. Pas de compte, pas d'inscription, aucun profil vous concernant côté serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてローカルファーストの仕組みで動作します。アカウントも登録も、サーバー側にあなたのプロフィールが残ることもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 것이 로컬 우선 구조로 작동합니다. 계정도, 가입도, 서버에 남는 프로필도 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wszystko działa w architekturze lokalnej. Bez kont, bez rejestracji, bez profilu na serwerze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo funciona em uma arquitetura local-first. Sem contas, sem cadastro, sem perfil seu armazenado no servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一切都基于本地优先架构运行。无需账户、无需注册，服务器端也不会保存你的个人资料。"
          }
        }
      }
    },
